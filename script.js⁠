document.addEventListener('DOMContentLoaded', () => {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const matchList = document.getElementById('match-list');
    const updateDate = document.getElementById('update-date');

    // 今日を入れる
    const today = new Date();
    if (updateDate) {
        updateDate.textContent = today.toLocaleDateString('ja-JP', { month: '2-digit', day: '2-digit' }) + ' ' + today.toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' });
    }

    const dummyData = {
        'europe': [
            { time: '21:00', league: 'プレミア', home: 'アーセナル', away: 'マンチェスター・C' },
            { time: '23:30', league: 'ラ・リーガ', home: 'レアル・マドリード', away: 'バルセロナ' }
        ],
        'japanese': [
            { time: '20:00', league: 'プレミア', home: 'ブライトン (三笘)', away: 'リヴァプール (遠藤)' },
            { time: '22:30', league: 'ブンデス', home: 'フライブルク (堂安)', away: 'バイエルン' }
        ],
        'national': [
            { time: '19:30', league: 'W杯予選', home: '日本代表', away: 'オーストラリア' }
        ]
    };

    function renderMatches(tabId) {
        if (!matchList) return;
        matchList.innerHTML = '';
        const matches = dummyData[tabId] || [];

        if (matches.length === 0) {
            matchList.innerHTML = '<div style="text-align: center; padding: 20px; color: #94a3b8;">試合予定はありません。</div>';
            return;
        }

        matches.forEach(match => {
            const card = document.createElement('div');
            card.style.cssText = 'background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 16px; margin-bottom: 12px; display: flex; justify-content: space-between;';
            card.innerHTML = `
                <div style="color: #38bdf8; font-weight: bold;">${match.time}</div>
                <div>${match.home} vs ${match.away}</div>
                <div style="color: #94a3b8; font-size: 0.8rem;">${match.league}</div>
            `;
            matchList.appendChild(card);
        });
    }

    renderMatches('europe');

    tabBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
            tabBtns.forEach(b => b.classList.remove('active'));
            e.target.classList.add('active');
            const tabId = e.target.getAttribute('data-tab');
            renderMatches(tabId);
        });
    });
});
