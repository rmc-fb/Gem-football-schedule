// schedule.jsonからデータを読み込んで表示する
async function loadAndDisplayMatches() {
    try {
        // 同じ階層にあるschedule.jsonを読み込む
        const response = await fetch('./schedule.json');
        
        if (!response.ok) {
            throw new Error('データの読み込みに失敗しました');
        }

        const data = await response.json();
        const container = document.getElementById('schedule-list');
        
        // 念のため初期化
        container.innerHTML = '';

        // データが配列であることを確認してループ処理
        if (Array.isArray(data)) {
            data.forEach(match => {
                // 試合情報を取得（構造は取得データに合わせて適宜調整してください）
                const home = match.homeTeam?.name || '不明';
                const away = match.awayTeam?.name || '不明';
                const date = match.startTimestamp ? new Date(match.startTimestamp * 1000).toLocaleString() : '日時未定';
                
                // HTMLを作成して追加
                const matchEl = document.createElement('div');
                matchEl.className = 'match-card';
                matchEl.innerHTML = `
                    <h3>${home} vs ${away}</h3>
                    <p>キックオフ: ${date}</p>
                `;
                container.appendChild(matchEl);
            });
        } else {
            container.innerHTML = '<p>試合データが見つかりませんでした。</p>';
        }

    } catch (error) {
        console.error("エラー:", error);
        document.getElementById('schedule-list').innerHTML = '<p>データの表示に失敗しました。</p>';
    }
}

// ページ読み込み時に実行
document.addEventListener('DOMContentLoaded', loadAndDisplayMatches);
