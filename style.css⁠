body {
    background-color: #0f172a !important; /* 強制的にダークモードにします */
    color: #f8fafc;
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 20px;
}

.header-container {
    text-align: center;
    padding: 20px 0;
}

h1 {
    font-size: 1.5rem;
    margin: 0;
}

.subtitle {
    color: #94a3b8;
    font-size: 0.9rem;
    margin: 5px 0;
}

.tabs-container {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 10px 0;
    margin-bottom: 20px;
}

.tab-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #94a3b8;
    padding: 8px 16px;
    border-radius: 20px;
    cursor: pointer;
    white-space: nowrap;
}

.tab-btn.active {
    background: #38bdf8;
    color: #0f172a;
    font-weight: bold;
}

.loading-state {
    text-align: center;
    padding: 40px;
    color: #94a3b8;
}
