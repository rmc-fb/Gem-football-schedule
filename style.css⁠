/* --- Webフォントの読み込み --- */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap');

/* --- ベーススタイル --- */
:root {
    --bg-gradient: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    --glass-bg: rgba(30, 41, 59, 0.6);
    --glass-border: rgba(255, 255, 255, 0.1);
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --accent-color: #10b981; /* エメラルドグリーン */
    --accent-glow: rgba(16, 185, 129, 0.3);
    --font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: var(--bg-gradient);
    background-attachment: fixed;
    color: var(--text-main);
    font-family: var(--font-family);
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

/* --- 1. ヘッダー --- */
header {
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--glass-border);
    padding: 32px 16px;
    text-align: center;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);
    position: sticky;
    top: 0;
    z-index: 100;
}

.header-container h1 {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
    /* 文字にグラデーションを適用 */
    background: linear-gradient(to right, #10b981, #3b82f6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 2px 10px rgba(16, 185, 129, 0.2);
}

.subtitle {
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 16px;
}

.update-time {
    font-size: 0.8rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.05);
    display: inline-block;
    padding: 6px 16px;
    border-radius: 20px;
    border: 1px solid var(--glass-border);
}

.update-time strong {
    color: var(--accent-color);
}

.auto-notice {
    margin-left: 8px;
    opacity: 0.8;
}

/* --- 2. フィルターエリア (すりガラス風カード) --- */
main {
    flex: 1;
    max-width: 1000px;
    width: 100%;
    margin: 0 auto;
    padding: 32px 16px;
}

.filter-section {
    background: var(--glass-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 16px;
    border: 1px solid var(--glass-border);
    padding: 24px;
    margin-bottom: 32px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
}

/* タブボタン (モダンなピル形状) */
.tabs-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 24px;
}

.tab-btn {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--text-muted);
    padding: 14px 8px;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-main);
    transform: translateY(-2px);
}

.tab-btn.active {
    background: var(--accent-color);
    border-color: var(--accent-color);
    color: #ffffff;
    box-shadow: 0 4px 15px var(--accent-glow);
}

/* コントロールエリア */
.controls-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
    border-top: 1px solid var(--glass-border);
    padding-top: 24px;
}

.control-group {
    display: flex;
    align-items: center;
    gap: 16px;
}

.control-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    min-width: 70px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.radio-buttons {
    display: flex;
    gap: 24px;
}

.radio-label {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 600;
    transition: color 0.2s;
}

.radio-label:hover {
    color: var(--accent-color);
}

.radio-label input[type="radio"] {
    accent-color: var(--accent-color);
    width: 18px;
    height: 18px;
    cursor: pointer;
}

/* セレクトボックス */
.select-wrapper {
    flex: 1;
    position: relative;
}

#league-select {
    width: 100%;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--glass-border);
    color: var(--text-main);
    padding: 12px 16px;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    appearance: none;
    outline: none;
    transition: border-color 0.2s;
}

#league-select:focus {
    border-color: var(--accent-color);
}

/* リセットボタン */
.reset-btn {
    background: transparent;
    border: 1px solid var(--glass-border);
    color: var(--text-muted);
    padding: 12px 20px;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
}

.reset-btn:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-main);
    border-color: var(--text-main);
}

/* --- 3. メインコンテンツエリア --- */
.content-section {
    min-height: 300px;
}

.loading-state {
    text-align: center;
    padding: 80px 16px;
    color: var(--text-muted);
    font-weight: 600;
    background: var(--glass-bg);
    border-radius: 16px;
    border: 1px dashed var(--glass-border);
}

/* クールなローディングアニメーション */
.spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(16, 185, 129, 0.1);
    border-radius: 50%;
    border-top-color: var(--accent-color);
    margin: 0 auto 20px;
    animation: spin 0.8s cubic-bezier(0.6, 0.2, 0.4, 0.8) infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

/* --- 4. フッター --- */
footer {
    background: rgba(15, 23, 42, 0.9);
    border-top: 1px solid var(--glass-border);
    padding: 32px 16px;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
}

.footer-container p {
    margin-bottom: 8px;
}

.credits {
    opacity: 0.6;
    font-size: 0.75rem;
}

/* --- レスポンシブ対応 --- */
@media (min-width: 768px) {
    .tabs-container {
        grid-template-columns: repeat(6, 1fr);
    }
    
    .controls-container {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    .select-wrapper {
        width: 240px;
        flex: none;
    }
}
