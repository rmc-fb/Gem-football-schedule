/* --- ベーススタイル --- */
:root {
    --bg-color: #121824;
    --card-bg: #1e2640;
    --text-color: #f3f4f6;
    --text-muted: #9ca3af;
    --accent-color: #10b981;
    --accent-hover: #059669;
    --border-color: #374151;
    --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background-color: var(--bg-color);
    color: var(--text-color);
    font-family: var(--font-family);
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

/* --- 1. ヘッダー --- */
header {
    background-color: var(--card-bg);
    border-bottom: 1px solid var(--border-color);
    padding: 24px 16px;
    text-align: center;
}

.header-container h1 {
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
}

.subtitle {
    color: var(--text-muted);
    font-size: 1rem;
    margin-bottom: 12px;
}

.update-time {
    font-size: 0.85rem;
    color: var(--text-muted);
}

.update-time strong {
    color: var(--text-color);
}

.auto-notice {
    display: inline-block;
    background-color: rgba(255, 255, 255, 0.05);
    padding: 2px 8px;
    border-radius: 4px;
    margin-left: 8px;
}

/* --- 2. フィルターエリア --- */
main {
    flex: 1;
    max-width: 1000px;
    width: 100%;
    margin: 0 auto;
    padding: 24px 16px;
}

.filter-section {
    background-color: var(--card-bg);
    border-radius: 8px;
    border: 1px solid var(--border-color);
    padding: 16px;
    margin-bottom: 24px;
}

/* タブボタンのグリッド配置 */
.tabs-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-bottom: 16px;
}

.tab-btn {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    color: var(--text-color);
    padding: 12px 8px;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
}

.tab-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.tab-btn.active {
    background-color: var(--accent-color);
    border-color: var(--accent-color);
    color: #ffffff;
}

/* コントロールエリア（ラジオ＆セレクト） */
.controls-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-top: 1px solid var(--border-color);
    padding-top: 16px;
}

.control-group {
    display: flex;
    align-items: center;
    gap: 12px;
}

.control-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    min-width: 70px;
}

.radio-buttons {
    display: flex;
    gap: 16px;
}

.radio-label {
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    font-size: 0.95rem;
}

.radio-label input[type="radio"] {
    accent-color: var(--accent-color);
    width: 16px;
    height: 16px;
}

/* セレクトボックス */
.select-wrapper {
    flex: 1;
    position: relative;
}

#league-select {
    width: 100%;
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    color: var(--text-color);
    padding: 10px 12px;
    border-radius: 6px;
    font-size: 0.95rem;
    cursor: pointer;
    appearance: none;
}

/* リセットボタン */
.reset-btn {
    background-color: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    padding: 10px 16px;
    border-radius: 6px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s;
}

.reset-btn:hover {
    border-color: var(--text-muted);
    color: var(--text-color);
}

/* --- 3. メインコンテンツエリア --- */
.content-section {
    min-height: 200px;
}

.loading-state {
    text-align: center;
    padding: 48px 16px;
    color: var(--text-muted);
}

/* ローディングアニメーション */
.spinner {
    width: 32px;
    height: 32px;
    border: 3px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    border-top-color: var(--accent-color);
    margin: 0 auto 16px;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

/* --- 4. フッター --- */
footer {
    background-color: var(--card-bg);
    border-top: 1px solid var(--border-color);
    padding: 24px 16px;
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-muted);
}

.footer-container p {
    margin-bottom: 8px;
}

.footer-container p:last-child {
    margin-bottom: 0;
}

.credits {
    opacity: 0.7;
}

/* --- レスポンシブ対応 (PC用レイアウト調整) --- */
@media (min-width: 640px) {
    .tabs-container {
        grid-template-columns: repeat(6, 1fr);
    }
    
    .controls-container {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    .select-wrapper {
        width: 200px;
        flex: none;
    }
}
